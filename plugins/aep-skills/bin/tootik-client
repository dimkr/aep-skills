#!/bin/sh

config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/aep-skills"
host_file="$config_dir/host"

if [ ! -s "$host_file" ]; then
	echo "tootik-client: no tootik host configured." >&2
	echo "Ask the user for the tootik host (never guess it), then save it with:" >&2
	echo "  mkdir -p \"$config_dir\" && echo <host> > \"$host_file\"" >&2
	echo "and run the command again." >&2
	exit 1
fi

host=$(cat "$host_file")

gobin=$(go env GOBIN)
[ -n "$gobin" ] || gobin="$(go env GOPATH)/bin"

if [ -x "$gobin/tootik-client" ]; then
	exec "$gobin/tootik-client" -host "$host" "$@"
fi

exec env CGO_ENABLED=0 go run github.com/dimkr/tootik/cmd/tootik-client@shell -host "$host" "$@"
