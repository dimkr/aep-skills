#!/bin/sh
# tootik-client — thin wrapper bundled with the aep-skills plugin.
#
# Runs tootik's cmd/tootik-client from the `shell` branch of
# github.com/dimkr/tootik via `go run`, so no compiled binary is committed and
# it works on both Linux and macOS.
#
# The tootik instance is selected by a host that is remembered GLOBALLY (not
# per task or per session) in a config file under the Claude config directory
# (${CLAUDE_CONFIG_DIR:-$HOME/.claude}). This wrapper reads that file and injects
# `-host <host>` into every call; the host is never guessed. If no host has been
# configured yet, the wrapper exits with instructions to ask the user and save
# it.
#
# Requirements on the target device (not installed by this plugin):
#   * `go` on PATH
#   * network access to the Go module proxy / github.com
#   * a reachable tootik instance at the configured host
#
# The plugin's SessionStart hook pre-warms the build, so the first real call is
# fast; a cold run compiles the command and Go caches it for later runs.

config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/aep-skills"
host_file="$config_dir/host"

if [ ! -s "$host_file" ]; then
	echo "tootik-client: no tootik host configured." >&2
	echo "Ask the user for the tootik host (never guess it), then save it with:" >&2
	echo "  mkdir -p \"$config_dir\" && echo <host> > \"$host_file\"" >&2
	echo "and run the command again." >&2
	exit 1
fi

host=$(cat "$host_file")

exec env CGO_ENABLED=0 go run -tags fts5 github.com/dimkr/tootik/cmd/tootik-client@shell -host "$host" "$@"
