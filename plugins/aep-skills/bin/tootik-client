#!/bin/sh

config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/aep-skills"
mkdir -p "$config_dir" || exit 1

host_file="$config_dir/host"
user_file="$config_dir/user"

client_path="$config_dir/tootik-client"
sm=`uname -sm`
case "$sm" in
"Darwin arm64") exec_name=tootik-client-darwin-arm64 ;;
"Linux x86_64") exec_name=tootik-client-linux-amd64 ;;
"Linux aarch64") exec_name=tootik-client-linux-arm64 ;;
MINGW64_NT*x86_64|MSYS_NT*x86_64)
	exec_name=tootik-client-windows-amd64.exe
	client_path="$config_dir/tootik-client.exe"
	;;
MINGW64_NT*aarch64|MSYS_NT*aarch64)
	exec_name=tootik-client-windows-arm64.exe
	client_path="$config_dir/tootik-client.exe"
	;;
*)
	echo "tootik-client: no prebuilt executable for ${sm}." >&2
	exit 1
	;;
esac

if [ ! -x "$client_path" ]; then
	tmp_path="${client_path}.tmp"
	rm -f "$tmp_path"
	curl -fL -o "$tmp_path" "https://github.com/dimkr/tootik/releases/latest/download/${exec_name}" || exit 1
	mv -f "$tmp_path" "$client_path"
	chmod +x "$client_path"
fi

host=`cat "$host_file" 2>/dev/null | grep -oE '[a-z0-9.:-]+'`

if [ -z "$host" ]; then
	echo "tootik-client: no tootik host configured." >&2
	echo "Ask the user for the tootik host (never guess it), then save it with:" >&2
	echo "  echo <host> > \"$host_file\"" >&2
	echo "and run the command again." >&2
	exit 1
fi

# Optional, unlike the host. The binary defaults to the OS user name, which is
# right on a personal machine and wrong wherever the account on the tootik
# instance is named something else -- a shared devbox, a CI runner, or any
# login that does not match. Absent, nothing changes.
user=`cat "$user_file" 2>/dev/null | grep -oE '[a-zA-Z0-9._-]+'`

if [ -n "$user" ]; then
	exec "$client_path" -host "$host" -user "$user" "$@"
fi

exec "$client_path" -host "$host" "$@"